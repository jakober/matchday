# Verteilung an TestFlight.
#
# Warum Fastlane und nicht nur xcodebuild: Xcodes automatische Signierung baut
# das Archiv mit einem Entwicklerzertifikat und braucht dafuer ein registriertes
# Geraet. Fuer eine reine TestFlight-Verteilung ist das unnoetiger Ballast.
# Hier wird stattdessen direkt ein Verteilungszertifikat samt App-Store-Profil
# ueber die App-Store-Connect-Schnittstelle besorgt und manuell signiert.

default_platform(:ios)

APP_IDENTIFIER = "com.jakober.matchday"

# Eigener Schluesselbund statt des Anmelde-Schluesselbunds: Der ist auf einem
# CI-Laeufer gesperrt, und das Zertifikat liesse sich nicht ablegen.
KEYCHAIN_NAME = "matchday_ci"
KEYCHAIN_PASSWORD = "matchday_ci"

platform :ios do
  desc "Baut die App und laedt sie zu TestFlight hoch"
  lane :beta do
    keychain_path = File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db")

    create_keychain(
      name: KEYCHAIN_NAME,
      password: KEYCHAIN_PASSWORD,
      default_keychain: true,
      unlock: true,
      # Kein Zeitablauf: Sonst sperrt sich der Schluesselbund mitten im Build
      # wieder zu und das Signieren scheitert ohne brauchbare Meldung.
      timeout: 0,
      lock_when_sleeps: false,
    )

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_PRIVATE_KEY"),
      in_house: false,
    )

    # Verteilungszertifikat holen oder anlegen - ausdruecklich in unseren
    # Schluesselbund.
    cert(
      api_key: api_key,
      development: false,
      keychain_path: keychain_path,
      keychain_password: KEYCHAIN_PASSWORD,
    )

    # Passendes App-Store-Profil holen oder anlegen.
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      development: false,
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.message("Verwende Profil: #{profile_name}")

    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ipa",
      clean: false,
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
        "MARKETING_VERSION=#{ENV.fetch('APP_VERSION')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}",
      ].join(" "),
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
        teamID: ENV.fetch("APPLE_TEAM_ID"),
      },
    )

    upload_to_testflight(
      api_key: api_key,
      # Nicht auf Apples Verarbeitung warten - die dauert 10 bis 20 Minuten
      # und blockiert sonst den Laeufer.
      skip_waiting_for_build_processing: true,
    )
  end
end
